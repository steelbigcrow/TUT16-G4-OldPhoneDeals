# MongoDB 数据库连接URI
# 开发环境示例
MONGODB_URI_DEV=mongodb://localhost:27017/oldphonedeals-dev
MONGODB_URI_PROD=mongodb://localhost:27017/OldPhoneDeals

# MONGODB_URI (optional legacy/fallback)
# MONGODB_URI=mongodb://localhost:27017/OldPhoneDeals
# 生产环境示例（使用副本集以支持事务）
# MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/oldphonedeals?replicaSet=rs0&authSource=admin

# Logging (optional, useful on Windows to avoid /var/log paths)
# LOG_FILE_NAME=./logs/application.log

# JWT 配置
# JWT密钥（生产环境必须使用强密钥，至少256位）
JWT_SECRET=your-secret-key-here-change-in-production-at-least-256-bits-long
# JWT过期时间（毫秒）- 默认7天，可选
# JWT_EXPIRATION=604800000

# SendGrid 邮件服务配置
# SendGrid API密钥
SENDGRID_API_KEY=SG.your-sendgrid-api-key
# 发件人邮箱地址
FROM_EMAIL=noreply@oldphonedeals.com

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# 前端应用URL
# 开发环境
FRONTEND_URL=http://localhost:4200
# 生产环境示例
# FRONTEND_URL=https://oldphonedeals.com

# 文件上传配置
# 文件上传目录（可选，有默认值）
# 开发环境
# UPLOAD_DIR=./dev-uploads
# 生产环境
# UPLOAD_DIR=/var/www/oldphonedeals/uploads

# 服务器端口（可选，默认3000）
# PORT=3000

# Spring Profile（可选）
# 开发环境使用 dev，生产环境使用 prod
# SPRING_PROFILES_ACTIVE=dev

# Mongo 事务开关（副本集环境建议启用）
# APP_MONGO_TRANSACTIONS_ENABLED=false
